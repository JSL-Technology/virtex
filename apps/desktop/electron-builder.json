{
  "appId": "io.virtex.desktop",
  "productName": "Virtex Desktop",
  "directories": {
    "output": "dist/apps/desktop-package"
  },
  "files": [
    "apps/desktop/src/**/*",
    "!apps/desktop/src/**/*.test.js"
  ],
  "mac": {
    "category": "public.app-category.business",
    "target": [
      "dmg"
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "notarize": true
  },
  "win": {
    "target": [
      "nsis"
    ],
    "signingHashAlgorithms": [
      "sha256"
    ],
    "publisherName": [
      "JSL Technology"
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Office"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "publish": [
    {
      "provider": "github",
      "owner": "JSL-Technology",
      "repo": "virtex",
      "releaseType": "release"
    }
  ]
}
