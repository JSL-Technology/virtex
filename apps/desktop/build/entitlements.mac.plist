<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Virtex Desktop: the minimum, and nothing else.

  allow-jit is the one exception V8 needs to compile JavaScript. Everything the hardened runtime
  forbids by default stays forbidden, and apps/desktop/build-config.test.js fails if any of these
  is ever added:
    - com.apple.security.cs.disable-library-validation  (would let any dylib load into the process)
    - com.apple.security.cs.allow-dyld-environment-variables  (DYLD_INSERT_LIBRARIES injection)
    - com.apple.security.cs.allow-unsigned-executable-memory
    - com.apple.security.cs.debugger / get-task-allow  (attach a debugger to a signed build)
  No camera, microphone, location or file-access entitlements: the shell asks for none of them.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
