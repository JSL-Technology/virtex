{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitReturns": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    // `dom.iterable` alongside `dom`: without it a `NodeListOf` has no `[Symbol.iterator]`, so
    // `for (const el of root.querySelectorAll(...))` — which every browser has supported for a
    // decade and which the specs use freely — did not compile. Four spec files failed
    // `nx typecheck` on nothing else, which is why the target had never passed.
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false,
    "typeCheckHostBindings": false,
    "strictTemplates": false,
    "fullTemplateTypeCheck": false
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}