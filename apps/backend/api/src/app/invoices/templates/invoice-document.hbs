<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>{{title}} {{invoice.invoiceNumber}}</title>
<style>
  /* Printed representation: ink on paper, deliberately independent of the app's theme. */
  * { box-sizing: border-box; }
  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #111;
    background: #fff;
    font-size: 11px;
    line-height: 1.45;
    margin: 0;
  }
  .sheet { max-width: 190mm; margin: 0 auto; }

  header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
  .issuer h1 { font-size: 15px; margin: 0 0 4px; }
  .issuer p { margin: 0; font-size: 10.5px; }
  .logo { max-width: 150px; max-height: 64px; }

  .fiscal-box {
    border: 1.5px solid #111;
    padding: 8px 12px;
    min-width: 62mm;
    text-align: center;
  }
  .fiscal-box .doc-title { font-size: 12px; font-weight: 700; letter-spacing: .04em; }
  .fiscal-box .ncf { font-size: 15px; font-weight: 700; font-family: 'Courier New', monospace; margin: 4px 0; }
  .fiscal-box .meta { font-size: 9.5px; }
  .draft-banner {
    border: 1.5px dashed #a11; color: #a11; font-weight: 700;
    padding: 6px 12px; text-align: center; letter-spacing: .1em;
  }

  .parties { display: flex; gap: 16px; margin-top: 14px; }
  .party { flex: 1; border: 1px solid #ccc; padding: 8px 10px; }
  .party h2 { font-size: 9px; text-transform: uppercase; letter-spacing: .1em; margin: 0 0 4px; color: #555; }
  .party p { margin: 0; }

  table.lines { width: 100%; border-collapse: collapse; margin-top: 14px; }
  table.lines th {
    background: #eee; border-bottom: 1.5px solid #111; padding: 5px 6px;
    font-size: 9px; text-transform: uppercase; letter-spacing: .06em; text-align: left;
  }
  table.lines td { border-bottom: 1px solid #e3e3e3; padding: 5px 6px; vertical-align: top; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .center { text-align: center; }

  .footer-grid { display: flex; gap: 16px; margin-top: 14px; align-items: flex-start; }
  .verification { flex: 1; border: 1px solid #ccc; padding: 10px; text-align: center; }
  .verification img { width: 34mm; height: 34mm; }
  .verification .code { font-family: 'Courier New', monospace; font-size: 13px; font-weight: 700; letter-spacing: .12em; }
  .verification .label { font-size: 8.5px; text-transform: uppercase; letter-spacing: .08em; color: #555; }
  .verification .url { font-size: 7.5px; word-break: break-all; color: #444; }

  table.totals { min-width: 68mm; border-collapse: collapse; }
  table.totals td { padding: 3px 6px; }
  table.totals td.label { text-align: right; color: #333; }
  table.totals tr.grand td { border-top: 1.5px solid #111; font-weight: 700; font-size: 13px; padding-top: 6px; }

  .notes { margin-top: 12px; border-top: 1px solid #ddd; padding-top: 8px; font-size: 10px; }
  .legal { margin-top: 14px; font-size: 8.5px; color: #555; text-align: center; }
</style>
</head>
<body>
<div class="sheet">

  <header>
    <div class="issuer">
      {{#if organization.logoUrl}}
        <img class="logo" src="{{organization.logoUrl}}" alt="{{organization.legalName}}">
      {{/if}}
      <h1>{{organization.legalName}}</h1>
      {{#if organization.commercialName}}<p>{{organization.commercialName}}</p>{{/if}}
      <p>{{taxIdLabel}}: <strong>{{organization.taxId}}</strong></p>
      {{#if organization.address}}<p>{{organization.address}}</p>{{/if}}
      <p>
        {{#if organization.city}}{{organization.city}}{{/if}}{{#if organization.state}}, {{organization.state}}{{/if}}
      </p>
      {{#if organization.phone}}<p>{{t 'invoice.pdf.tel_phone' phone=organization.phone}}</p>{{/if}}
      {{#if organization.email}}<p>{{organization.email}}</p>{{/if}}
    </div>

    {{#if fiscal.isDraft}}
      <div class="draft-banner">
        {{t 'invoice.pdf.draft_watermark'}}<br>
        <span style="font-weight:400;letter-spacing:0">{{t 'invoice.pdf.no_fiscal_value'}}</span>
      </div>
    {{else}}
      <div class="fiscal-box">
        <div class="doc-title">{{t 'invoice.pdf.electronic_title' title=title}}</div>
        <div class="ncf">{{fiscal.ncf}}</div>
        <div class="meta">
          {{#if fiscal.validUntil}}{{t 'invoice.pdf.valid_until' date=fiscal.validUntil}}<br>{{/if}}
          {{t 'invoice.pdf.internal_number' number=invoice.invoiceNumber}}
        </div>
      </div>
    {{/if}}
  </header>

  <div class="parties">
    <div class="party">
      <h2>{{t 'invoice.pdf.buyer'}}</h2>
      <p><strong>{{invoice.customerName}}</strong></p>
      {{#if invoice.customerTaxId}}<p>{{customerTaxIdLabel}}: {{invoice.customerTaxId}}</p>{{/if}}
      {{#if invoice.customerAddress}}<p>{{invoice.customerAddress}}</p>{{/if}}
    </div>
    <div class="party">
      <h2>{{t 'invoice.pdf.document'}}</h2>
      <p>{{t 'invoice.pdf.issue_date'}} <strong>{{issueDate}}</strong></p>
      <p>{{t 'invoice.pdf.due_date_due_date' dueDate=dueDate}}</p>
      <p>{{t 'invoice.pdf.currency_currency_code' currencyCode=currencyCode}}</p>
      {{#if fiscal.signedAt}}<p>{{t 'invoice.pdf.signed_signed' signedAt=fiscal.signedAt}}</p>{{/if}}
    </div>
  </div>

  <table class="lines">
    <thead>
      <tr>
        <th style="width:6%">#</th>
        <th>{{t 'invoice.pdf.description'}}</th>
        <th style="width:10%" class="num">{{t 'invoice.pdf.qty'}}</th>
        <th style="width:8%" class="center">{{t 'invoice.pdf.unit_of_measure_short'}}</th>
        <th style="width:14%" class="num">{{t 'invoice.pdf.price'}}</th>
        <th style="width:10%" class="num">{{t 'invoice.pdf.disc'}}</th>
        <th style="width:8%" class="center">{{t 'invoice.pdf.tax_column_header'}}</th>
        <th style="width:16%" class="num">{{t 'invoice.pdf.amount'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each lines}}
      <tr>
        <td class="center">{{this.number}}</td>
        <td>{{this.description}}</td>
        <td class="num">{{this.quantity}}</td>
        <td class="center">{{this.unitOfMeasure}}</td>
        <td class="num">{{this.price}}</td>
        <td class="num">{{#if this.discount}}{{this.discount}}{{else}}—{{/if}}</td>
        <td class="center">{{this.taxRate}}</td>
        <td class="num">{{this.amount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="footer-grid">
    {{#unless fiscal.isDraft}}
    <div class="verification">
      <div class="label">{{t 'invoice.pdf.dgii_verification'}}</div>
      {{#if fiscal.qrDataUri}}
        <img src="{{fiscal.qrDataUri}}" alt="{{t 'invoice.pdf.qr_code_verify_document'}}">
      {{/if}}
      {{#if fiscal.securityCode}}
        <div class="label" style="margin-top:4px">{{t 'invoice.pdf.security_code'}}</div>
        <div class="code">{{fiscal.securityCode}}</div>
      {{/if}}
      {{#if fiscal.qrUrl}}<div class="url">{{fiscal.qrUrl}}</div>{{/if}}
    </div>
    {{/unless}}

    <div style="margin-left:auto">
      <table class="totals">
        <tr><td class="label">{{t 'invoice.pdf.subtotal'}}</td><td class="num">{{totals.subtotal}}</td></tr>
        {{#if totals.discount}}<tr><td class="label">{{t 'invoice.pdf.discount'}}</td><td class="num">−{{totals.discount}}</td></tr>{{/if}}
        {{#if totals.exempt}}<tr><td class="label">{{t 'invoice.pdf.exempt_amount'}}</td><td class="num">{{totals.exempt}}</td></tr>{{/if}}
        <tr><td class="label">{{t 'invoice.pdf.taxed_amount'}}</td><td class="num">{{totals.taxed}}</td></tr>
        <tr><td class="label">{{t 'invoice.pdf.tax_column_header'}}</td><td class="num">{{totals.tax}}</td></tr>
        {{#if totals.serviceCharge}}<tr><td class="label">{{t 'invoice.pdf.statutory_service_charge_10'}}</td><td class="num">{{totals.serviceCharge}}</td></tr>{{/if}}
        <tr class="grand"><td class="label">{{t 'invoice.pdf.total_currencycode' currencyCode=currencyCode}}</td><td class="num">{{totals.total}}</td></tr>
        {{#if totals.taxWithheld}}<tr><td class="label">{{t 'invoice.pdf.itbis_withheld'}}</td><td class="num">−{{totals.taxWithheld}}</td></tr>{{/if}}
        {{#if totals.incomeTaxWithheld}}<tr><td class="label">{{t 'invoice.pdf.income_tax_withheld'}}</td><td class="num">−{{totals.incomeTaxWithheld}}</td></tr>{{/if}}
        {{#if totals.netReceivable}}<tr><td class="label">{{t 'invoice.pdf.net_payable'}}</td><td class="num"><strong>{{totals.netReceivable}}</strong></td></tr>{{/if}}
      </table>
    </div>
  </div>

  {{#if invoice.notes}}
  <div class="notes"><strong>{{t 'invoice.pdf.notes'}}</strong> {{invoice.notes}}</div>
  {{/if}}

  <div class="legal">
    {{#unless fiscal.isDraft}}
      {{t 'invoice.pdf.legal_issued'}}
    {{else}}
      {{t 'invoice.pdf.legal_draft'}}
    {{/unless}}
  </div>

</div>
</body>
</html>
