<!DOCTYPE html>
<html lang="{{language}}" dir="{{dir}}">
<head>
    <meta charset="UTF-8">
    <title>{{t 'INVOICE.PDF.TITLE' number=invoiceNumber}}</title>
    <style>
        /* Estilos optimizados para la plantilla */
        body { font-family: 'Helvetica Neue', 'Helvetica', Arial, sans-serif; color: #333; }
        .invoice-box { max-width: 800px; margin: auto; padding: 30px; border: 1px solid #eee; box-shadow: 0 0 10px rgba(0, 0, 0, .15); font-size: 16px; line-height: 24px; }
        .invoice-box table { width: 100%; line-height: inherit; text-align: start; border-collapse: collapse; }
        .invoice-box table td { padding: 5px; vertical-align: top; }
        .invoice-box .top-section table td { padding-bottom: 20px; }
        .invoice-box .top-section .title { font-size: 45px; line-height: 45px; color: #333; }
        .invoice-box .info-section table td { padding-bottom: 40px; }
        .invoice-box .heading td { background: #eee; border-bottom: 1px solid #ddd; font-weight: bold; }
        .invoice-box .details td { padding-bottom: 20px; }
        .invoice-box .item td { border-bottom: 1px solid #eee; }
        .invoice-box .item.last td { border-bottom: none; }
        .invoice-box .total td:nth-child(2) { border-top: 2px solid #eee; font-weight: bold; }
        /* `end`, not `right`: the alignment of a figures column follows the writing direction. */
        .text-end { text-align: end; }
        .logo-img { max-width: 150px; max-height: 75px; }
    </style>
</head>
<body>
    <div class="invoice-box">
        <table>
            <tr class="top-section">
                <td colspan="4">
                    <table>
                        <tr>
                            <td class="title">
                                {{#if organization.logoUrl}}
                                    <img src="{{organization.logoUrl}}" alt="{{organization.legalName}}" class="logo-img">
                                {{else}}
                                    <h2>{{organization.legalName}}</h2>
                                {{/if}}
                            </td>
                            <td>
                                <strong>{{t 'INVOICE.PDF.NUMBER'}}</strong> {{invoiceNumber}}<br>
                                <strong>{{t 'INVOICE.PDF.ISSUE_DATE'}}</strong> {{issueDate}}<br>
                                <strong>{{t 'INVOICE.PDF.DUE_DATE'}}</strong> {{dueDate}}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr class="info-section">
                <td colspan="4">
                    <table>
                        <tr>
                            <td>
                                {{organization.legalName}}<br>
                                {{organization.address}}<br>
                                {{!--
                                  The tax-identifier label comes from the country profile. It was
                                  the literal "RNC:" — the Dominican one — printed on every
                                  invoice from every market, so a Mexican tenant's CFDI showed its
                                  RFC under a Dominican heading.
                                --}}
                                {{taxIdLabel}}: {{organization.taxId}}
                            </td>
                            <td>
                                {{customerName}}<br>
                                {{customerAddress}}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr class="heading">
                <td>{{t 'INVOICE.PDF.DESCRIPTION'}}</td>
                <td class="text-end">{{t 'INVOICE.PDF.QUANTITY'}}</td>
                <td class="text-end">{{t 'INVOICE.PDF.UNIT_PRICE'}}</td>
                <td class="text-end">{{t 'INVOICE.PDF.LINE_TOTAL'}}</td>
            </tr>
            {{#each lineItems}}
            <tr class="item">
                <td>{{this.description}}</td>
                <td class="text-end">{{number this.quantity}}</td>
                {{!--
                  `money` carries the invoice's own currency code. The template used to print a
                  literal `$` in front of a figure formatted as `en-US`, so a DOP invoice read as
                  dollars and an Argentine one lost its thousands separator.
                --}}
                <td class="text-end">{{money this.price ../currencyCode}}</td>
                <td class="text-end">{{money (multiply this.quantity this.price) ../currencyCode}}</td>
            </tr>
            {{/each}}
            <tr class="total">
                <td colspan="3" class="text-end">{{t 'INVOICE.PDF.SUBTOTAL'}}</td>
                <td class="text-end">{{money subtotal currencyCode}}</td>
            </tr>
            <tr class="total">
                <td colspan="3" class="text-end">{{taxLabel}}</td>
                <td class="text-end">{{money tax currencyCode}}</td>
            </tr>
            <tr class="total">
                <td colspan="3" class="text-end"><strong>{{t 'INVOICE.PDF.TOTAL'}}</strong></td>
                <td class="text-end"><strong>{{money total currencyCode}}</strong></td>
            </tr>
        </table>
        {{#if notes}}
        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee;">
            <strong>{{t 'INVOICE.PDF.NOTES'}}</strong><br>
            {{notes}}
        </div>
        {{/if}}
    </div>
</body>
</html>
