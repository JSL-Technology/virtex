{{#> shell title=(t 'MAIL.DUPLICATE_REGISTRATION.INTENTO_REGISTRO') preheader=(t 'MAIL.DUPLICATE_REGISTRATION.SIN_EMBARGO_YA_EXISTE_CUENTA_ASOCIADA')}}
<h1 class="ink" style="margin:0 0 18px; font:600 24px/1.28 {{brand 'font'}}; letter-spacing:-0.02em; color:{{brand 'ink'}};">{{t 'MAIL.DUPLICATE_REGISTRATION.INTENTO_REGISTRO'}}</h1>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.COMMON.GREETING' name=name}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.DUPLICATE_REGISTRATION.REQUEST_INTRO' appName=appName}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.DUPLICATE_REGISTRATION.SIN_EMBARGO_YA_EXISTE_CUENTA_ASOCIADA'}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.DUPLICATE_REGISTRATION.SI_FUISTE_TU_QUIEN_INTENTO_REGISTRARSE'}}</p>

{{> button href=loginUrl label=(t 'MAIL.DUPLICATE_REGISTRATION.INICIAR_SESION')}}

<p class="ink3" style="margin:0; font:400 14px/1.65 {{brand 'font'}}; color:{{brand 'ink3'}}; text-align:center;">
  {{t 'MAIL.DUPLICATE_REGISTRATION.SI_OLVIDASTE_TU_CONTRASENA_PUEDES_RESTABLECERLA'}}
  <a class="link hover-underline" href="{{resetPasswordUrl}}" style="color:{{brand 'accentText'}}; font-weight:600;">{{t 'MAIL.DUPLICATE_REGISTRATION.RESTABLECER_CONTRASENA'}}</a>
</p>

{{#> note}}{{t 'MAIL.DUPLICATE_REGISTRATION.SI_NO_FUISTE_TU_PUEDES_IGNORAR'}}{{/note}}
{{/shell}}
