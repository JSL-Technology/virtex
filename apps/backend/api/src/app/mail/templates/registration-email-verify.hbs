{{#> shell title=(t 'MAIL.REGISTRATION_EMAIL_VERIFY.CONFIRMA_TU_CORREO_ELECTRONICO') preheader=(t 'MAIL.REGISTRATION_EMAIL_VERIFY.COMPLETAR_TU_REGISTRO_DEBES_CONFIRMAR_TU')}}
<h1 class="ink" style="margin:0 0 18px; font:600 24px/1.28 {{brand 'font'}}; letter-spacing:-0.02em; color:{{brand 'ink'}};">{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.CONFIRMA_TU_CORREO_ELECTRONICO'}}</h1>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.HOLA'}} <strong class="ink" style="font-weight:600; color:{{brand 'ink'}};">{{name}}</strong></p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.COMPLETAR_TU_REGISTRO_DEBES_CONFIRMAR_TU'}}</p>

<p class="ink3" style="margin:26px 0 0; font:600 12px/1.5 {{brand 'font'}}; letter-spacing:0.1em; text-transform:uppercase; color:{{brand 'ink3'}};">{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.OPCION_CLIC'}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.HAZ_CLIC_BOTON_ABAJO_CONFIRMAR_TU'}}</p>

{{> button href=magicLinkUrl label=(t 'MAIL.REGISTRATION_EMAIL_VERIFY.CONFIRMAR_CORREO_ELECTRONICO')}}

<p class="ink3" style="margin:26px 0 0; font:600 12px/1.5 {{brand 'font'}}; letter-spacing:0.1em; text-transform:uppercase; color:{{brand 'ink3'}};">{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.OPCION_CODIGO_VERIFICACION'}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.INGRESA_ESTE_CODIGO_FORMULARIO_REGISTRO'}}</p>

{{> code value=code}}

<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.ESTE_CODIGO_ENLACE_EXPIRAN'}} <strong class="ink" style="font-weight:600; color:{{brand 'ink'}};">{{t 'TIME.MINUTES' count=expiresMinutes}}</strong>.</p>

{{#> note}}{{t 'MAIL.REGISTRATION_EMAIL_VERIFY.NO_COMPARTAS_ESTE_CODIGO_NADIE_NUESTRO'}} {{t 'MAIL.REGISTRATION_EMAIL_VERIFY.SI_NO_SOLICITASTE_ESTO_PUEDES_IGNORAR'}}{{/note}}
{{/shell}}
