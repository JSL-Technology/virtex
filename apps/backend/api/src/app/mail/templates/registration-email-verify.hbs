{{#> shell title=(t 'mail.registration_email_verify.confirm_your_email_address') preheader=(t 'mail.registration_email_verify.finish_signing_up_you_need_confirm')}}
<h1 class="ink" style="margin:0 0 18px; font:600 24px/1.28 {{brand 'font'}}; letter-spacing:-0.02em; color:{{brand 'ink'}};">{{t 'mail.registration_email_verify.confirm_your_email_address'}}</h1>
{{!-- El saludo lleva el nombre solo si se conoce. Se enviaba siempre el literal «Usuario», así
      que el correo abría «Hola Usuario»: un mail-merge que se ve fallado. --}}
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{#if name}}{{t 'mail.registration_email_verify.hello'}} <strong class="ink" style="font-weight:600; color:{{brand 'ink'}};">{{name}}</strong>{{else}}{{t 'mail.registration_email_verify.greeting_without_name'}}{{/if}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'mail.registration_email_verify.finish_signing_up_you_need_confirm'}}</p>

<p class="ink3" style="margin:26px 0 0; font:600 12px/1.5 {{brand 'font'}}; letter-spacing:0.1em; text-transform:uppercase; color:{{brand 'ink3'}};">{{t 'mail.registration_email_verify.option_one_click'}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'mail.registration_email_verify.click_button_below_confirm_your_address'}}</p>

{{> button href=magicLinkUrl label=(t 'mail.registration_email_verify.confirm_email_address')}}

<p class="ink3" style="margin:26px 0 0; font:600 12px/1.5 {{brand 'font'}}; letter-spacing:0.1em; text-transform:uppercase; color:{{brand 'ink3'}};">{{t 'mail.registration_email_verify.option_verification_code'}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'mail.registration_email_verify.enter_code_sign_up_form'}}</p>

{{> code value=code}}

<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'mail.registration_email_verify.code_link_expire'}} <strong class="ink" style="font-weight:600; color:{{brand 'ink'}};">{{t 'TIME.MINUTES' count=expiresMinutes}}</strong>.</p>

{{#> note}}{{t 'mail.registration_email_verify.do_not_share_code_with_anyone'}} {{t 'mail.registration_email_verify.if_you_did_not_request_you'}}{{/note}}
{{/shell}}
