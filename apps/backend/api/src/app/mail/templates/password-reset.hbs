{{#> shell title=(t 'mail.password_reset.password_reset_app_name' appName=appName) preheader=(t 'mail.password_reset.use_link_below_reset_your_app' appName=appName expiration=(t expiration.unitKey count=expiration.count))}}
<h1 class="ink" style="margin:0 0 18px; font:600 24px/1.28 {{brand 'font'}}; letter-spacing:-0.02em; color:{{brand 'ink'}};">{{t 'mail.password_reset.password_reset'}}</h1>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'mail.common.hello_name' name=name}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'mail.password_reset.we_received_request_reset_password_your' appName=appName}}</p>

{{> button href=resetLink label=(t 'mail.password_reset.reset_password')}}

<p class="ink3" style="margin:0; font:400 14px/1.65 {{brand 'font'}}; color:{{brand 'ink3'}}; text-align:center;">{{t 'mail.password_reset.link_valid_for' expiration=(t expiration.unitKey count=expiration.count)}}</p>

{{> link-fallback href=resetLink label=(t 'mail.common.if_button_does_not_work_copy')}}

{{#> note}}{{t 'mail.password_reset.did_you_not_request_change_you'}}{{/note}}
{{/shell}}
