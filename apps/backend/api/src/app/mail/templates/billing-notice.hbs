{{#> shell title=(t titleKey) preheader=(t bodyKey params=params)}}
<h1 class="ink" style="margin:0 0 18px; font:600 24px/1.28 {{brand 'font'}}; letter-spacing:-0.02em; color:{{brand 'ink'}};">{{t titleKey}}</h1>
{{!-- El cuerpo es una clave más sus valores, resuelta en el idioma del destinatario. --}}
<p class="ink2" style="margin:0; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t bodyKey params=params}}</p>

{{> button href=billingUrl label=(t 'mail.billing_notice.go_billing')}}

{{> link-fallback href=billingUrl label=(t 'mail.common.if_button_does_not_work_copy')}}
{{/shell}}
