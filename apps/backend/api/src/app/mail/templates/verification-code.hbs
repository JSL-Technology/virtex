<!DOCTYPE html>
<html lang="{{language}}" dir="{{dir}}">
<head>
    <meta charset="utf-8">
    <title>{{t 'MAIL.VERIFICATION_CODE.CODIGO_VERIFICACION'}}</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
        <h2>{{t 'MAIL.COMMON.GREETING' name=name}}</h2>
        <p>{{t 'MAIL.VERIFICATION_CODE.HAS_SOLICITADO_HABILITAR_AUTENTICACION_DOS_PASOS'}}</p>
        <p>{{t 'MAIL.VERIFICATION_CODE.CONTINUAR_FAVOR_INGRESA_SIGUIENTE_CODIGO_VERIFICACION'}}</p>

        <div style="background-color: #f4f4f4; padding: 15px; border-radius: 5px; text-align: center; font-size: 24px; letter-spacing: 5px; font-weight: bold; margin: 20px 0;">
            {{code}}
        </div>

        <p>{{t 'MAIL.VERIFICATION_CODE.ESTE_CODIGO_EXPIRARA_10_MINUTOS'}}</p>
        <p>{{t 'MAIL.VERIFICATION_CODE.SI_NO_SOLICITASTE_ESTE_CAMBIO_FAVOR'}}</p>

        <p>{{t 'MAIL.VERIFICATION_CODE.SALUDOS'}}<br>{{t 'MAIL.COMMON.SIGNATURE' appName=appName}}</p>
    </div>
</body>
</html>
