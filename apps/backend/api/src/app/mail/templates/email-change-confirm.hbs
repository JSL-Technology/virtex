{{#> shell title=(t 'mail.email_change_confirm.confirm_your_new_email_app_name' appName=appName) preheader=(t 'mail.email_change_confirm.confirm_change_your_email_address_app' appName=appName expiresMinutes=expiresMinutes)}}
<h1 class="ink" style="margin:0 0 18px; font:600 24px/1.28 {{brand 'font'}}; letter-spacing:-0.02em; color:{{brand 'ink'}};">{{t 'mail.email_change_confirm.confirm_your_new_email_address'}}</h1>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'mail.common.hello_name' name=name}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'mail.email_change_confirm.we_received_request_change_email_address' appName=appName}}</p>

{{> button href=confirmUrl label=(t 'mail.email_change_confirm.confirm_email_address')}}

<p class="ink3" style="margin:0; font:400 14px/1.65 {{brand 'font'}}; color:{{brand 'ink3'}}; text-align:center;">{{t 'mail.email_change_confirm.link_valid'}} <strong class="ink" style="font-weight:600; color:{{brand 'ink'}};">{{t 'TIME.MINUTES' count=expiresMinutes}}</strong>.</p>

{{> link-fallback href=confirmUrl label=(t 'mail.common.if_button_does_not_work_copy')}}

{{#> note}}{{t 'mail.email_change_confirm.did_you_not_request_change_you'}}{{/note}}
{{/shell}}
