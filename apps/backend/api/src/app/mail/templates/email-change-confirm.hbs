{{#> shell title=(t 'MAIL.EMAIL_CHANGE_CONFIRM.CONFIRMA_TU_NUEVO_CORREO_APPNAME' appName=appName) preheader=(t 'MAIL.EMAIL_CHANGE_CONFIRM.CONFIRMA_CAMBIO_TU_CORREO_ELECTRONICO_APPNAME' appName=appName expiresMinutes=expiresMinutes)}}
<h1 class="ink" style="margin:0 0 18px; font:600 24px/1.28 {{brand 'font'}}; letter-spacing:-0.02em; color:{{brand 'ink'}};">{{t 'MAIL.EMAIL_CHANGE_CONFIRM.CONFIRMA_TU_NUEVO_CORREO_ELECTRONICO'}}</h1>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.COMMON.GREETING' name=name}}</p>
<p class="ink2" style="margin:0 0 16px; font:400 16px/1.65 {{brand 'font'}}; color:{{brand 'ink2'}};">{{t 'MAIL.EMAIL_CHANGE_CONFIRM.REQUEST_INTRO' appName=appName}}</p>

{{> button href=confirmUrl label=(t 'MAIL.EMAIL_CHANGE_CONFIRM.CONFIRMAR_CORREO_ELECTRONICO')}}

<p class="ink3" style="margin:0; font:400 14px/1.65 {{brand 'font'}}; color:{{brand 'ink3'}}; text-align:center;">{{t 'MAIL.EMAIL_CHANGE_CONFIRM.ESTE_ENLACE_ES_VALIDO'}} <strong class="ink" style="font-weight:600; color:{{brand 'ink'}};">{{t 'TIME.MINUTES' count=expiresMinutes}}</strong>.</p>

{{> link-fallback href=confirmUrl label=(t 'MAIL.COMMON.LINK_FALLBACK')}}

{{#> note}}{{t 'MAIL.EMAIL_CHANGE_CONFIRM.NO_SOLICITASTE_ESTE_CAMBIO_PUEDES_IGNORAR'}}{{/note}}
{{/shell}}
