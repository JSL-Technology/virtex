# =============================================================================
# VARIABLES DE ENTORNO — ERP-API (NESTJS)
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] must be set before starting the app.
# =============================================================================

# -----------------------------------------------------------------------------
# RECAPTCHA
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_V3_SECRET_KEY=your_recaptcha_v3_secret_key

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200
APP_NAME="Billio"
# Public base URL of the API (scheme + host + prefix). Used to build OAuth/SSO callback URLs
# that are registered in the identity providers. Must be reachable by the browser.
API_PUBLIC_URL=http://localhost:3000/api/v1

# -----------------------------------------------------------------------------
# DATABASE (POSTGRESQL) [REQUIRED]
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=erp
DB_SYNCHRONIZE=false

# -----------------------------------------------------------------------------
# AUTHENTICATION (JWT) [ALL REQUIRED IN PRODUCTION]
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Each secret MUST be different from all others (key separation — NIST SP 800-57).
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET
JWT_2FA_TEMP_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET
JWT_PREVERIFY_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET

JWT_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_REMEMBER_ME_EXPIRATION=30d
JWT_RESET_PASSWORD_EXPIRATION=15m

# -----------------------------------------------------------------------------
# ENCRYPTION [REQUIRED IN PRODUCTION]
# Used to encrypt IP addresses stored in refresh_tokens (AES-256-GCM).
# -----------------------------------------------------------------------------
ENCRYPTION_SECRET=REPLACE_WITH_STRONG_SECRET
AUTH_SALT=REPLACE_WITH_UNIQUE_SALT

# -----------------------------------------------------------------------------
# MAIL
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Billio"

# -----------------------------------------------------------------------------
# THROTTLE / RATE LIMITING
# -----------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=10
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL=60000

# -----------------------------------------------------------------------------
# REDIS [REQUIRED IN PRODUCTION for distributed throttling & caching]
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# STRIPE [REQUIRED for payment features]
# Use sk_test_... (secret key), NOT pk_test_... (publishable key)!
# Get keys at: https://dashboard.stripe.com/apikeys
# Get webhook secret from: https://dashboard.stripe.com/webhooks
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_ENDPOINT_SECRET

# -----------------------------------------------------------------------------
# SOCIAL / OIDC LOGIN — shared
# -----------------------------------------------------------------------------
# Secret used to encrypt+sign the short-lived OAuth handshake cookie (state/nonce/PKCE).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to ENCRYPTION_SECRET if unset; MUST be set explicitly in production.
OAUTH_STATE_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# -----------------------------------------------------------------------------
# GOOGLE OIDC (social login)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# MICROSOFT OIDC (social login — Microsoft Entra ID / Azure AD, v2.0 endpoint)
# Register an app at: https://entra.microsoft.com (App registrations).
# Redirect URI (Web platform) must match MICROSOFT_CALLBACK_URL exactly.
# MICROSOFT_TENANT:
#   common        -> any work/school account + personal Microsoft accounts (default)
#   organizations -> any work/school (Azure AD) account
#   consumers     -> personal Microsoft accounts only
#   <tenant-guid> -> a single specific tenant (strict issuer validation)
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT=common

# -----------------------------------------------------------------------------
# ENTERPRISE SSO (Phase 2) — per-tenant OIDC IdPs (Okta, Entra, Ping, Auth0...)
# These are configured per organization in the database (IdentityProvider), NOT here.
# Each customer brings their own issuer/clientId/clientSecret via the admin UI.
# The IdP client secret is encrypted at rest using ENCRYPTION_SECRET.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# TWILIO (SMS for OTP and MFA) [REQUIRED for phone verification]
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# -----------------------------------------------------------------------------
# AWS S3 (File Storage)
# -----------------------------------------------------------------------------
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# -----------------------------------------------------------------------------
# WEB PUSH (VAPID)
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# -----------------------------------------------------------------------------
# SWAGGER (Protect Swagger UI in non-production environments)
# -----------------------------------------------------------------------------
SWAGGER_USER=admin
SWAGGER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# XE CURRENCY API
# -----------------------------------------------------------------------------
XE_API_ID=your_xe_api_id
XE_API_KEY=your_xe_api_key
BASE_CURRENCY=USD

# =============================================================================
# AUTHENTICATION & SESSION SECURITY
# =============================================================================
# NOTE ON NODE_ENV: development fallbacks for the secrets below are ONLY served when
# NODE_ENV is exactly "development" or "test". Any other value — "staging", "prod", a typo,
# or unset — is treated as a real deployment and the process refuses to start without a
# strong secret. This is deliberate: a process that cannot authenticate securely must not
# accept traffic.

# --- Reverse proxy -----------------------------------------------------------
# REQUIRED in any environment behind a load balancer, CDN or reverse proxy (Render,
# Cloudflare, nginx). Without it every request reports the proxy's IP, which disables
# rate limiting (one shared bucket for the whole platform), brute-force lockout,
# impossible-travel detection and per-session IP display.
#   1        trust exactly one proxy hop (recommended default in production)
#   2        trust N hops (e.g. CDN in front of a load balancer)
#   true     trust every hop — ONLY when the app is unreachable except through the proxy,
#            otherwise a client can spoof its IP via X-Forwarded-For
#   CIDR     an explicit allow-list, e.g. "10.0.0.0/8,192.168.1.1" (most precise)
TRUST_PROXY=1

# --- RS256 signing key ring --------------------------------------------------
# REQUIRED outside development/test. Access tokens are RS256-signed; a mismatched pair
# fails fast at boot rather than breaking every request at runtime.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Newlines may be escaped as \n on a single line.
RS_PRIVATE_KEY=
RS_PUBLIC_KEY=
RS_KEY_ID=key-1
# Zero-downtime key rotation: JSON map of kid -> public PEM that may still VERIFY but never
# sign. Deploy the new key as RS_PRIVATE_KEY/RS_PUBLIC_KEY with the previous public key
# listed here, then drop the entry once the longest access-token lifetime has elapsed.
# Verifying keys are published at GET /api/v1/auth/.well-known/jwks.json
# RS_RETIRED_PUBLIC_KEYS={"key-0":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}

# --- Secrets ------------------------------------------------------------------
# JWT_REFRESH_SECRET, JWT_2FA_TEMP_SECRET, JWT_PREVERIFY_SECRET, ENCRYPTION_SECRET and
# AUTH_SALT are declared in the section above. Each must be a distinct value of at least
# 32 characters (openssl rand -hex 32) and must not match a placeholder pattern, or the
# process refuses to start outside development/test.
# Only the two secrets introduced by this work are listed here:
CSRF_SECRET=
JWT_STEP_UP_SECRET=

# --- Token & cookie lifetimes ------------------------------------------------
# JWT_ACCESS_EXPIRATION / JWT_REFRESH_EXPIRATION / JWT_REFRESH_REMEMBER_ME_EXPIRATION are
# declared in the section above. They accept s/m/h/d/w and compound forms ("1h30m"); an
# unparseable value now throws at startup instead of silently falling back to 15 minutes,
# which previously let the token and the cookie carrying it drift to different lifetimes.
JWT_STEP_UP_EXPIRATION=10m
# Impersonated sessions are deliberately short: elevated access to another person's account
# should expire on its own rather than persist as a multi-day refresh token.
AUTH_IMPERSONATION_DURATION=30m
# Tolerance for concurrent refreshes from the same rotation (ms). Only applies to tokens
# superseded by rotation — never to tokens revoked by logout.
AUTH_REFRESH_GRACE_PERIOD=2000

# --- Password policy ---------------------------------------------------------
# Screen new passwords against Have I Been Pwned via k-anonymity (only the first 5 chars
# of the SHA-1 hash leave the server). Fails open if HIBP is unreachable.
AUTH_PASSWORD_BREACH_CHECK=true
AUTH_PASSWORD_BREACH_TIMEOUT_MS=2000
AUTH_ARGON2_MEMORY_COST=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=4

# --- TOTP --------------------------------------------------------------------
# Steps accepted either side of the current one (clock-skew tolerance). Each accepted step
# is burned after use, so a code cannot be replayed inside its window.
AUTH_TOTP_WINDOW=1
AUTH_TOTP_STEP_SECONDS=30
