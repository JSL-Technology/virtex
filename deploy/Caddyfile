# One origin for the ERP (/), the point of sale (/pos/) and the API (/api/*).
#
# DOMAIN is the public hostname; Caddy obtains and renews its TLS certificate automatically.
# API_UPSTREAM is where the API listens (the `api` service in docker-compose.prod.yml).
{
	email {$ACME_EMAIL:ops@example.com}
	servers {
		# Behind Caddy the API sees one proxy hop: TRUST_PROXY=1.
		trusted_proxies static private_ranges
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# The API. Metrics are scraped on the internal network, never through the public origin.
	@metrics path /api/*/health/metrics
	respond @metrics 404

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			header_up X-Forwarded-Proto {scheme}
			# A DGII or Azul round trip, or a PDF render, can take a while.
			transport http {
				read_timeout 120s
			}
		}
	}

	# The point of sale, its own bundle, SPA fallback to its own index.
	handle_path /pos/* {
		root * /srv/pos
		import spa_headers
		try_files {path} /index.html
		file_server
	}
	redir /pos /pos/ 308

	# The ERP.
	handle {
		root * /srv/app
		import spa_headers
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

# The headers apps/*/public/serve.json declares for the static bundles.
(spa_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https: data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}
	@html path / /index.html
	header @html Cache-Control "no-store"
	@assets path *.js *.css *.woff2 *.png *.svg *.webp *.ico
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
