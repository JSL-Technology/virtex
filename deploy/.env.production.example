# Producción en República Dominicana — plantilla para deploy/docker-compose.prod.yml.
# Copia a deploy/.env.production (no se versiona) y rellena cada valor. La API valida la
# configuración al arrancar y se niega a servir si falta algo obligatorio.
# Genera cada secreto por separado:  openssl rand -hex 32

# ── Dominio y HTTPS ──────────────────────────────────────────────────────────
DOMAIN=app.ejemplo.do
ACME_EMAIL=ops@ejemplo.do
FRONTEND_URL=https://app.ejemplo.do
CORS_ORIGIN=https://app.ejemplo.do
API_PUBLIC_URL=https://app.ejemplo.do/api/v1
PUBLIC_API_URL=https://app.ejemplo.do/api/v1
WEBAUTHN_RP_ID=app.ejemplo.do
API_REPLICAS=2
IMAGE_PREFIX=ghcr.io/jsl-technology/virtex
IMAGE_TAG=latest

# ── Base de datos y Redis ────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=virteex
DB_USERNAME=virteex
DB_PASSWORD=
DB_SSL=false
# Rol sin privilegios con el que la API obedece las políticas RLS (lo crea la migración).
APP_DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Secretos de la aplicación ────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_2FA_TEMP_SECRET=
JWT_PREVERIFY_SECRET=
JWT_SOCIAL_REGISTER_SECRET=
JWT_STEP_UP_SECRET=
CSRF_SECRET=
ENCRYPTION_SECRET=
AUTH_SALT=
OAUTH_STATE_SECRET=
ECF_CERT_ENCRYPTION_KEY=

# ── Correo transaccional ─────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@ejemplo.do
MAIL_FROM_NAME=Virteex
SUPPORT_EMAIL=soporte@ejemplo.do

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

# ── DGII (e-CF) ──────────────────────────────────────────────────────────────
# TesteCF → CerteCF → Produccion, en ese orden, a medida que avance la certificación.
DGII_ECF_ENVIRONMENT=TesteCF

# ── Cobro de la suscripción: Azul ────────────────────────────────────────────
PAYMENT_PROVIDER=azul
AZUL_ENVIRONMENT=test
AZUL_MERCHANT_ID=
AZUL_MERCHANT_NAME=VIRTEEX
AZUL_AUTH_KEY=
AZUL_AUTH1=
AZUL_AUTH2=
AZUL_CERT_PATH=/run/secrets/azul.crt
AZUL_KEY_PATH=/run/secrets/azul.key
SAAS_BASE_CURRENCY=DOP
SAAS_PRICE_STARTER_DOP=
SAAS_PRICE_PRO_DOP=
SAAS_PRICE_ENTERPRISE_DOP=
SAAS_TRIAL_DAYS=14
# El inquilino que es la propia empresa Virteex y su producto de servicio: e-CF por cada cobro.
PLATFORM_BILLING_ORGANIZATION_ID=
PLATFORM_BILLING_PRODUCT_ID=

# ── Operación ────────────────────────────────────────────────────────────────
METRICS_TOKEN=
ALERT_WEBHOOK_URL=
BACKUP_RETENTION_DAYS=35
BACKUP_HOUR_UTC=7
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1
BACKUP_ENCRYPTION_PASSPHRASE=
